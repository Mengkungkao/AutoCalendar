# Copy to .env.local for local runs. On Vercel, set these under
# Project → Settings → Environment Variables instead. Keys stay on the server.

# At least one reading service. Set both to choose between them in Settings.
# Claude:  console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# OpenAI:  platform.openai.com → API keys
OPENAI_API_KEY=

# The password that unlocks the site. Use a long one: anyone who has it can spend your API credit.
APP_PASSWORD=

# Optional:
# ROSTER_PROVIDER=anthropic          # what "Automatic" uses when both keys are set (anthropic | openai)
# ROSTER_CLAUDE_MODEL=claude-opus-5-5
# ROSTER_CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max
# ROSTER_OPENAI_MODEL=gpt-6.1-sol
# ROSTER_OPENAI_EFFORT=medium        # low | medium | high | xhigh | max
