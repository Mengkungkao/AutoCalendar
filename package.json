{
  "name": "autocalendar",
  "version": "0.1.0",
  "private": true,
  "description": "Upload a weekly roster photo; get Apple Calendar (.ics) files for your shifts, with travel time and reminders.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.mts",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "heic-to": "1.5.2",
    "next": "16.4.2",
    "openai": "7.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "ical.js": "2.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
